@article{OnKs25b,
  abbr={},
  title={The 1980s Recession and US Labor Market Inequality},
  author={Stavreva, Kamelia},
  state={Job Market Paper},
  pdf = {onoratod_jmp.pdf},
  abstract={Almost 60 percent of the sharp rise in 90–10 wage inequality since 1979 happened between 1980 and 1985, amidst the deep recessions of the early 1980s. This paper studies how this recession contributed to the abrupt transformation of the wage distribution over this period. We construct a new longitudinal employer-employee dataset for 5.3 million workers from Census administrative records and exploit variation in exposure to the recession across local labor markets to estimate the effects on workers’ labor market trajectories. We find that the recession persistently reduced earnings and employment, with the largest effects for workers at the bottom of the earnings distribution. Under a less severe recession counterfactual, we estimate that the rise in wage inequality between 1979 and 1988 would have been up to 20 percent smaller. We find no evidence that these effects reflect accelerated technological change or other lasting shifts in relative labor demand. Instead, we find that the recession persistently reduced unionization, and extrapolating our estimates suggests that the recession can account for 42 percent of the national decline in union density over the decade. Decomposing the recession’s impacts on aggregate inequality, we find that 35 to 40 percent is accounted for by its effects on unions, through both the reallocation of workers to non-union jobs and weaker union wage spillover effects. Our results suggest that the recession meaningfully contributed to the post-1980s rise in wage inequality and demonstrate how temporary aggregate shocks can have permanent impacts on inequality by reshaping wage-setting institutions.},
  expanded={true},
  type=article
}

@article{OnKs25,
  abbr={},
  title={Skin Tone and Racial Inequality in the US: Evidence from the 20th Century},
  author={Stavreva, Kamelia},
  journal={Working Paper},
  state={Working Papers},
  pdf={https://drive.google.com/file/d/140KZWdNuiea6JwxqHHnfNCA2mHoGZTq7/view},
  abstract={Empirical work on racial inequality typically relies on a binary Black–white comparison, treating racial categories as uniform and masking meaningful variation in how individuals are treated within groups. Using newly collected WWII draft registration records containing information on skin tone for the near universe of men born between 1898–1929, linked to the 1940 Census, we document large intra-racial disparities by skin color. Black men with light skin earn about 37\% more than their darker-skinned peers. This unconditional gap is economically significant—if all Black men earned what light-skinned Black men did, the Black–white earnings gap in 1940 would be roughly 18\% smaller. We explore several mechanisms behind these disparities. Comparing brothers raised in the same household, family fixed effects eliminate essentially the entire education gap, yet darker-skinned brothers still earn about 10\% less (9 log points), roughly a quarter of the unconditional gap in the sibling sample, pointing to a labor market penalty distinct from the categorical disadvantages tied to racial classification. We then consider the role of discriminatory institutions. While Jim Crow exposure depresses educational attainment for Black men overall, we find no differential impact by skin tone, consistent with the one-drop rule’s uniform legal treatment. Finally, we follow men from 1940 to 1950 and find that among men in the same 1940 occupation, lighter-skinned men were more likely to move into skilled work. Exploiting WWII-driven variation in labor market tightness, we find that shocks that reduced Black–white inequality had no detectable differential effect by skin tone. Our results show that skin tone inequality reflects both inherited disadvantage and distinct discriminatory forces that sort Black men along color lines. These forces likely differ from those driving broader racial inequality.},
  type=article
}

@article{KuNaOn25,
  abbr={},
  title={The Cold War and the US Labor Market},
  author={Kuziemko, Ilyana and Naidu, Suresh},
  state={Working Papers},
  journal={Reject and Resubmit, American Economic Review},
  pdf = {ColdWar_3feb2026.pdf},
  abstract={We argue that the Cold War contributed to the inclusive growth of the post-war
decades. On the labor-demand side, we isolate exogenous shifts in military procurement
across states and firms. We show that military procurement increases manufacturing
employment and reduces inequality. Overall, the 1950s-to-1990s decline in defense
production explains roughly one-quarter of the decline in manufacturing employment and
nearly one-tenth of the rise of top-ten income share. On the labor-supply side, the
Cold-War-era draft removed millions of young men from the labor force, significantly
reducing young male civilian unemployment. Military procurement also increased voter
support for hawkish foreign policy.},
  type=article
}

@article{OnKsStYi25,
  abbr={},
  title={From Callbacks to Careers: Do Audit Studies Predict Workforce Diversity},
  author={Stavreva, Kamelia and Adina Sterling and Yimfor, Emmanuel},
  journal={Working Paper},
  state={Working Papers},
  pdf={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6022958},
  abstract={Correspondence experiments are the gold standard for measuring hiring discrimination. However, two concerns persist. Callbacks measured in correspondence studies only track the initial interest of employers and not hiring itself, and the distinctive names that signal race in these experiments may signal socioeconomic status as well as race. We address both concerns by matching the firms in Kline, Rose, and Walters (2022)'s experiment to LinkedIn employment records of 9 million employees. We find that firms with larger callback gaps employ fewer Black workers. The employment gap is three times what callback gaps would predict, consistent with discrimination continuing beyond callbacks or with Black applicants sorting away from discriminatory firms. The relationship is strongest among the most discriminatory firms.. About 3\% of the Black workers we identify carry the experiment's distinctive names, yet callback gaps predict employment differences for the broader Black workforce. We release a firm-by-year panel of employment shares by race and gender for the audited firms and all Fortune 1000 firms from 2010 to 2024, together with our race-classification software, so that future correspondence experiments can be evaluated against hiring, not only callbacks.},
  type=article
}

